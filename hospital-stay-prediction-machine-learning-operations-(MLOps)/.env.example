# DagsHub Configuration
DAGSHUB_USER=your-dagshub-username
DAGSHUB_REPO=hospital-stay-prediction

# MLflow Configuration (Optional - defaults to hospital-stay-prediction)
MLFLOW_EXPERIMENT=hospital-stay-prediction

# AWS Configuration (For deployment only)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# ECR_REGISTRY=your-account-id.dkr.ecr.us-east-1.amazonaws.com
# ECS_CLUSTER=your-cluster-name
# ECS_SERVICE=hospital-stay-predictor
# ECS_TASK_DEFINITION=hospital-stay-predictor:1
